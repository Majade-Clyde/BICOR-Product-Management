# Server Configuration
PORT=5000
NODE_ENV=development

# Predefined Administrator Credentials
ADMIN_USERNAME=Adminclyde
ADMIN_EMAIL=your-admin-email@example.com

# Supabase Configuration
# Retrieve these from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SECRET_KEY=your-supabase-secret-role-key

# Client URL (for CORS allowed origins)
CLIENT_URL=http://localhost:5173
